import { createClient } from "@supabase/supabase-js";
import { revalidatePath } from "next/cache";
import { notFound } from "next/navigation";
import PrintButton from "../../print-button";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

// Approves the renewal in one action: accepts the quote and signs the engagement
// letter together, since for a renewal they represent a single decision by the
// client, not two separate approvals like a brand-new client's first engagement.
async function approveRenewal(token: string) {
  "use server";

  const { data: quote } = await supabase.from("quotes").select("id").eq("token", token).single();
  if (!quote) return;

  const now = new Date().toISOString();

  await supabase.from("quotes").update({ status: "Accepted", accepted_at: now }).eq("id", quote.id);
  await supabase.from("engagement_letters").update({ status: "Signed", signed_at: now }).eq("quote_id", quote.id);

  revalidatePath(`/renewal/${token}`);
}

async function queryRenewal(token: string) {
  "use server";

  const { data: quote } = await supabase.from("quotes").select("id").eq("token", token).single();
  if (!quote) return;

  await supabase.from("quotes").update({ status: "Declined", declined_at: new Date().toISOString() }).eq("id", quote.id);

  revalidatePath(`/renewal/${token}`);
}

export default async function RenewalPage({
  params,
}: {
  params: Promise<{ token: string }>;
}) {
  const { token } = await params;

  const { data: quote, error } = await supabase
    .from("quotes")
    .select("*, clients(client_name, address)")
    .eq("token", token)
    .single();

  if (error || !quote) notFound();

  const [{ data: lines }, { data: letter }, { data: practiceSettings }] = await Promise.all([
    supabase.from("quote_lines").select("*").eq("quote_id", quote.id),
    supabase.from("engagement_letters").select("*").eq("quote_id", quote.id).maybeSingle(),
    supabase.from("practice_settings").select("firm_name").limit(1).maybeSingle(),
  ]);

  const firmName = practiceSettings?.firm_name || "Your Accountant";
  const client = quote.clients as any;

  const approveWithToken = approveRenewal.bind(null, token);
  const queryWithToken = queryRenewal.bind(null, token);

  const isAccepted = quote.status === "Accepted";
  const isDeclined = quote.status === "Declined";
  const isResponded = isAccepted || isDeclined;

  const fmt = (n: number) => `£${n.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

  return (
    <div className="min-h-screen bg-slate-50 print:bg-white">

      <div className="bg-slate-900 text-white px-8 py-6 print:bg-white print:text-slate-900 print:border-b print:border-slate-300">
        <div className="max-w-3xl mx-auto flex items-center justify-between">
          <div>
            <h1 className="text-xl font-bold">{firmName}</h1>
            <p className="text-slate-400 text-sm mt-0.5 print:text-slate-500">Annual Renewal</p>
          </div>
          <div className="text-right">
            <p className="text-sm text-slate-400 print:text-slate-500">Quote {quote.quote_number}</p>
          </div>
        </div>
      </div>

      <div className="max-w-3xl mx-auto p-8">

        <div className="flex justify-end mb-4 print:hidden">
          <PrintButton />
        </div>

        {isAccepted && (
          <div className="mb-6 rounded-2xl bg-green-50 border border-green-200 p-4 text-center print:hidden">
            <p className="text-green-700 font-bold text-lg">✓ Renewal Approved</p>
            <p className="text-green-600 text-sm mt-1">Thank you! We'll get started on the year ahead.</p>
          </div>
        )}

        {isDeclined && (
          <div className="mb-6 rounded-2xl bg-yellow-50 border border-yellow-200 p-4 text-center print:hidden">
            <p className="text-yellow-700 font-bold text-lg">Query Raised</p>
            <p className="text-yellow-600 text-sm mt-1">Thanks for letting us know. We'll be in touch to discuss.</p>
          </div>
        )}

        <div className="rounded-2xl bg-white shadow-sm border border-slate-100 overflow-hidden print:border-0 print:shadow-none">

          <div className="p-6 border-b border-slate-100">
            <p className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Prepared for</p>
            <p className="mt-1 font-bold text-slate-900 text-lg">{client?.client_name || "Client"}</p>
            <p className="text-sm text-slate-500 mt-1">
              Continuing our engagement for the year ahead — please review the services and fee below.
            </p>

            {isAccepted && quote.accepted_at && (
              <p className="text-sm font-semibold text-green-700 mt-3 pt-3 border-t border-slate-100">
                ✓ Approved on {new Date(quote.accepted_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })} at {new Date(quote.accepted_at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })}
              </p>
            )}
          </div>

          {/* Quote / Fee section */}
          <div className="p-6 border-b border-slate-100">
            <h2 className="text-sm font-bold text-slate-900 uppercase tracking-wide mb-3">Services & Fee for the Coming Year</h2>
            <div className="space-y-2 text-sm">
              {(lines || []).map((l) => (
                <div key={l.id} className="flex justify-between">
                  <span className="text-slate-600">{l.description}</span>
                  <span className="font-medium">{fmt(Number(l.line_total))}</span>
                </div>
              ))}
              <div className="border-t border-slate-100 pt-2 flex justify-between">
                <span className="text-slate-500">Subtotal</span>
                <span className="font-medium">{fmt(Number(quote.subtotal || 0))}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">VAT</span>
                <span className="font-medium">{fmt(Number(quote.vat || 0))}</span>
              </div>
              <div className="flex justify-between font-bold text-base border-t border-slate-100 pt-2">
                <span>Total</span>
                <span>{fmt(Number(quote.total || 0))}</span>
              </div>
            </div>
          </div>

          {/* Engagement letter section */}
          {letter && (
            <div className="p-6 text-sm text-slate-700 leading-relaxed space-y-4">
              <h2 className="text-sm font-bold text-slate-900 uppercase tracking-wide">Terms of Engagement</h2>

              <p>
                We are pleased to continue our appointment as your accountants and tax advisers
                {letter.start_date && ` with effect from ${new Date(letter.start_date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}`}.
                This confirms the terms of our engagement for the year ahead.
              </p>

              <div>
                <p className="font-semibold text-slate-900">Services</p>
                <p className="mt-1 whitespace-pre-line">{letter.services_description}</p>
              </div>

              <div>
                <p className="font-semibold text-slate-900">Your Responsibilities</p>
                <p className="mt-1">
                  You are responsible for maintaining adequate accounting records and for making available to us all information relevant to the preparation of your accounts and returns.
                </p>
              </div>

              <div>
                <p className="font-semibold text-slate-900">Our Responsibilities</p>
                <p className="mt-1">
                  We will prepare your accounts and tax returns using the information and explanations provided to us.
                </p>
              </div>

              {letter.custom_terms && (
                <div>
                  <p className="font-semibold text-slate-900">Additional Terms</p>
                  <p className="mt-1 whitespace-pre-line">{letter.custom_terms}</p>
                </div>
              )}

              {isAccepted && letter.signed_at && (
                <p className="text-sm font-semibold text-green-700 pt-3 border-t border-slate-100">
                  ✓ Signed on {new Date(letter.signed_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
                </p>
              )}
            </div>
          )}
        </div>

        {!isResponded && (
          <div className="mt-8 rounded-2xl bg-white p-6 shadow-sm border border-slate-100 print:hidden">
            <h2 className="text-lg font-bold text-slate-900 text-center">
              Happy to continue on these terms?
            </h2>
            <p className="text-sm text-slate-500 text-center mt-1">
              Approving below confirms both the fee and the terms of engagement for the coming year.
            </p>

            <div className="mt-6 flex gap-4 justify-center">
              <form action={approveWithToken}>
                <button type="submit"
                  className="rounded-xl bg-green-600 px-8 py-3 text-sm font-bold text-white hover:bg-green-700 transition-colors">
                  ✓ Approve Renewal
                </button>
              </form>

              <form action={queryWithToken}>
                <button type="submit"
                  className="rounded-xl bg-white border border-slate-200 px-8 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50 transition-colors">
                  I Have a Question
                </button>
              </form>
            </div>
          </div>
        )}

        <p className="text-center text-xs text-slate-400 mt-6">
          Prepared by {firmName} · This is a renewal of an existing engagement.
        </p>

      </div>
    </div>
  );
}